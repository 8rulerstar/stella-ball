# 로컬/CI가 생성하는 증거 산출물은 원본 커밋과 분리한다.
artifacts/
.env
.env.*
!hive/.env.example

# Expanded roster keeps the approved 2x2 source atlases only.
assets/characters/expanded/*.png
!assets/characters/expanded/source/
!assets/characters/expanded/source/*.png

# Image-generation chroma-key sources are working material only.  The final
# transparent sprites in assets/characters/cute/ are the portable game assets.
assets/characters/cute/source/

