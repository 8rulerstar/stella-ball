# Public browser configuration. This contains only the deployed adapter URL.
# window.PRISM_HIVE_CONFIG = { proxyUrl: 'https://your-hive-adapter.example.com' }

# Used only by `node hive/spike.mjs`; never commit the actual file.
HIVE_PROXY_URL=https://your-hive-adapter.example.com
HIVE_SPIKE_TOKEN=replace-with-a-server-issued-test-token

# Set only in the adapter's deployment environment, never in GitHub Pages.
HIVE_APP_ID=
HIVE_APP_SECRET=
HIVE_DATASTORE_PUBLIC_KEY=
HIVE_WEB_LOGIN_REDIRECT_URI=
